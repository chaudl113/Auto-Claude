# Auto Claude Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# CLIPROXY MODE (RECOMMENDED - No Claude Pro/Max Required)
# =============================================================================
# Use CLIProxyAPI/ProxyPal to route API calls through multiple providers.
# This allows using Claude, GitHub Copilot, Gemini, and more without
# needing a Claude Pro/Max subscription.
#
# Prerequisites:
#   1. Install ProxyPal: https://github.com/heyhuynhgiabuu/proxy/releases
#   2. Start ProxyPal and connect your AI accounts
#   3. Enable CLIProxyAPI mode below

# Enable CLIProxyAPI mode (default: false)
CLIPROXY_ENABLED=true

# CLIProxyAPI endpoint (default: http://localhost:8317)
CLIPROXY_URL=http://localhost:8317

# CLIProxyAPI API key (from ProxyPal settings)
# CLIPROXY_API_KEY=your-proxy-api-key

# =============================================================================
# MODEL MAPPINGS (Required for CLIProxyAPI)
# =============================================================================
# Map Auto-Claude model names to CLIProxyAPI model names.
# Auto-Claude uses internal names like "claude-opus-4-5-20251101"
# CLIProxyAPI uses names like "claude-opus-4.5" or "copilot-claude-opus-4.5"

# Shorthand mappings (applies to all variants):
CLIPROXY_MODEL_OPUS=claude-opus-4.5
CLIPROXY_MODEL_SONNET=claude-sonnet-4.5
CLIPROXY_MODEL_HAIKU=claude-haiku-4.5

# Alternative: Use Copilot models (free with GitHub subscription):
# CLIPROXY_MODEL_OPUS=copilot-claude-opus-4.5
# CLIPROXY_MODEL_SONNET=copilot-claude-sonnet-4.5
# CLIPROXY_MODEL_HAIKU=copilot-claude-haiku-4.5

# Alternative: Use GPT models:
# CLIPROXY_MODEL_OPUS=copilot-gpt-5.1
# CLIPROXY_MODEL_SONNET=copilot-gpt-5
# CLIPROXY_MODEL_HAIKU=copilot-gpt-4.1

# =============================================================================
# AUTHENTICATION (ALTERNATIVE - Requires Claude Pro/Max)
# =============================================================================
# If CLIPROXY_ENABLED=false, Auto Claude uses Claude Code OAuth authentication.
# Direct API keys (ANTHROPIC_API_KEY) are NOT supported to prevent silent billing.
#
# Option 1: Run `claude setup-token` to save token to macOS Keychain (recommended)
# Option 2: Set the token explicitly:
# CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here
#
# For enterprise/proxy setups (CCR):
# ANTHROPIC_AUTH_TOKEN=sk-enterprise-token

# =============================================================================
# CUSTOM API ENDPOINT (OPTIONAL)
# =============================================================================
# Override the default Anthropic API endpoint. Useful for:
#   - Local proxies (ccr, litellm)
#   - API gateways
#   - Self-hosted Claude instances
#
# ANTHROPIC_BASE_URL=http://127.0.0.1:3456
#
# Related settings (usually set together with ANTHROPIC_BASE_URL):
# NO_PROXY=127.0.0.1
# DISABLE_TELEMETRY=true
# DISABLE_COST_WARNINGS=true
# API_TIMEOUT_MS=600000

# Model override (OPTIONAL)
# Default: claude-opus-4-5-20251101
# AUTO_BUILD_MODEL=claude-opus-4-5-20251101

# =============================================================================
# GIT/WORKTREE SETTINGS (OPTIONAL)
# =============================================================================
# Configure how Auto Claude handles git worktrees for isolated builds.

# Default base branch for worktree creation (OPTIONAL)
# If not set, Auto Claude will auto-detect main/master, or fall back to current branch.
# Common values: main, master, develop
# DEFAULT_BRANCH=main

# =============================================================================
# DEBUG MODE (OPTIONAL)
# =============================================================================
# Enable debug logging for development and troubleshooting.

# Enable debug mode (default: false)
# DEBUG=true

# Debug log level: 1=basic, 2=detailed, 3=verbose (default: 1)
# DEBUG_LEVEL=1

# =============================================================================
# GRAPHITI MEMORY INTEGRATION (OPTIONAL)
# =============================================================================
# Graphiti-based persistent memory layer for cross-session context retention.

# Enable Graphiti (default: true)
GRAPHITI_ENABLED=false

# LLM provider: openai | anthropic | azure_openai | ollama | google | openrouter
# GRAPHITI_LLM_PROVIDER=openai

# Embedder provider: openai | voyage | azure_openai | ollama | google | openrouter
# GRAPHITI_EMBEDDER_PROVIDER=openai

# =============================================================================
# PERFORMANCE FEATURES (OPTIONAL)
# =============================================================================
# Core performance optimizations for faster builds and better recovery.

# Enable agent state caching for faster session recovery (default: true)
# AGENT_CACHE_ENABLED=true

# Enable worktree pooling for faster worktree allocation (default: true)
# WORKTREE_POOL_ENABLED=true

# Number of worktrees to keep in the pool (default: 3, max: 8)
# WORKTREE_POOL_SIZE=3

# Enable parallel execution of independent subtasks (default: true)
# PARALLEL_EXECUTION_ENABLED=true

# Maximum number of tasks to run in parallel (default: 3)
# MAX_PARALLEL_TASKS=3

# =============================================================================
# MERGE SAFETY FEATURES (OPTIONAL)
# =============================================================================
# Safety features for merge operations.

# Enable AI diff preview before merge (default: true)
# DIFF_PREVIEW_ENABLED=true

# Enable automatic rollback on merge failure (default: true)
# ROLLBACK_ENABLED=true

# =============================================================================
# SPEC TEMPLATES (OPTIONAL)
# =============================================================================
# Pre-built templates for common spec types.

# Enable spec template system (default: true)
# SPEC_TEMPLATES_ENABLED=true

# Custom templates directory (default: ~/.auto-claude/templates)
# CUSTOM_TEMPLATES_DIR=~/.auto-claude/templates
